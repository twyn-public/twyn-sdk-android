<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog">

    <LinearLayout
        android:id="@+id/dlgHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:paddingTop="24dp"
        android:paddingBottom="22dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/dlgSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="46sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dlgStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="APROVADO"
            android:textSize="25sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/dlgSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="13sp"
            android:textColor="#E8FFFFFF"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dlgDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp" />

    <Button
        android:id="@+id/dlgClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:text="Fechar"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="15sp"
        android:backgroundTint="#0FB5B3"
        android:textColor="#FFFFFF" />
</LinearLayout>
